# systemd unit (Kubuntu / Ubuntu). Copy to /etc/systemd/system/, adjust User and paths, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now docmap-workstation
[Unit]
Description=Gateway workstation (modelli AI locali)
After=network-online.target
Wants=network-online.target

[Service]
User=dave
WorkingDirectory=/opt/docmap-workstation
ExecStart=/usr/bin/python3 -m docmap_workstation serve --config /opt/docmap-workstation/workstation.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
